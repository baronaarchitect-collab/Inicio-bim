rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // emailLower vincula los pagos de Wompi: solo puede ser el correo VERIFICADO del propio usuario.
    function validEmailLower() {
      return !('emailLower' in request.resource.data)
        || request.resource.data.emailLower == ''
        || (request.auth.token.email_verified == true
            && request.resource.data.emailLower == request.auth.token.email.lower());
    }
    // Cada usuario lee su documento y solo puede escribir sus datos de perfil y progreso.
    // "premium" y "subscription" solo los escriben las Cloud Functions (Admin SDK).
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'emailLower', 'progress', 'updatedAt'])
        && validEmailLower();
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'emailLower', 'progress', 'updatedAt'])
        && (!('progress' in request.resource.data) || request.resource.data.progress.size() < 200000)
        && validEmailLower();
    }
    // Proyectos del Checklist BIM: solo con acceso vigente (checklistProUntil lo escribe el Apps Script).
    match /users/{uid}/checklists/{projectId} {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && get(/databases/$(database)/documents/users/$(uid)).data.get('checklistProUntil', timestamp.value(0)) > request.time;
    }
    // Estudio de salas de ventas: cada usuario guarda y lee solo sus proyectos (Typeform, recorrido, dashboard, links).
    match /users/{uid}/salas/{salaId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.id == salaId
        && request.resource.data.keys().hasAll(['datos', 'tipologias', 'unidades'])
        && request.resource.data.unidades.size() <= 2000
        && request.resource.data.tipologias.size() <= 60;
    }
    // Links PRO (playbooks del marketplace, tablero de coordinación): solo lectura con acceso vigente.
    match /proLinks/{id} {
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('checklistProUntil', timestamp.value(0)) > request.time;
      allow write: if false;
    }
    // Compras de Wompi: solo el Apps Script (cuenta de servicio).
    match /purchases/{id} {
      allow read, write: if false;
    }
    // Vínculo suscripción → usuario: solo servidor.
    match /subscriptions/{id} {
      allow read, write: if false;
    }

    // ---- Salas de renders: inventario en la nube (dashboard → Accesos de cada sala, ver visor/renders/README.md) ----
    function correo() { return request.auth.token.email.lower(); }
    function verificado() { return request.auth != null && request.auth.token.email_verified == true; }
    // ⚠ Correos master (acceso total a todas las salas). No van en las salas publicadas.
    function esMaster() { return verificado() && correo() in ['baronajuandavid@gmail.com']; }
    function esVentas(sala) { return verificado() && exists(/databases/$(database)/documents/salasRenders/$(sala)/accesos/$(correo())); }
    function texto(v, n) { return v is string && v.size() <= n; }

    match /salasRenders/{sala} {
      // la sala pública lee los estados en vivo
      allow read: if true;
      allow create, delete: if esMaster();
      // ventas solo cambia estados, y firma con su correo
      allow update: if esMaster() || (esVentas(sala)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estados', 'actualizado', 'por'])
        && request.resource.data.estados.size() <= 3000
        && request.resource.data.por == correo());

      // accesos: solo el master los da o los quita; cada quien puede ver el suyo
      match /accesos/{email} {
        allow read: if esMaster() || (verificado() && correo() == email);
        allow write: if esMaster();
      }

      // separaciones pagadas: las deja la página de gracias (comprador sin sesión); ventas las revisa
      match /separaciones/{tx} {
        allow create: if exists(/databases/$(database)/documents/salasRenders/$(sala))
          && request.resource.data.keys().hasOnly(['unidad', 'transaccion', 'referencia', 'monto', 'moneda', 'nombre', 'correo', 'celular', 'estado', 'creado'])
          && request.resource.data.estado == 'nueva'
          && request.resource.data.creado == request.time
          && request.resource.data.transaccion == tx
          && texto(request.resource.data.unidad, 20) && texto(request.resource.data.referencia, 120)
          && texto(request.resource.data.nombre, 120) && texto(request.resource.data.correo, 120) && texto(request.resource.data.celular, 40)
          && request.resource.data.monto is number;
        allow read: if esMaster() || esVentas(sala);
        allow update: if (esMaster() || esVentas(sala))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'por', 'revisado'])
          && request.resource.data.estado in ['confirmada', 'descartada'];
        allow delete: if esMaster();
      }
    }
  }
}
