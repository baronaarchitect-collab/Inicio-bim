rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada usuario lee su documento y solo puede escribir sus datos de perfil y progreso.
    // "premium" y "subscription" solo los escriben las Cloud Functions (Admin SDK).
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'progress', 'updatedAt']);
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'progress', 'updatedAt'])
        && (!('progress' in request.resource.data) || request.resource.data.progress.size() < 200000);
    }
    // Vínculo suscripción → usuario: solo servidor.
    match /subscriptions/{id} {
      allow read, write: if false;
    }
  }
}
